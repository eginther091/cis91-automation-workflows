    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const order = $json;\nconst items = order.items.map(item => ({\n  ...item,\n  line_total: Math.round(item.quantity * item.unit_price * 100) / 100\n}));\n\nconst subtotal = items.reduce((sum, item) => sum + item.line_total, 0);\nconst tax_rate = 0.0775; // CA sales tax\nconst tax = Math.round(subtotal * tax_rate * 100) / 100;\nconst shipping_cost = order.shipping === 'express' ? 15.99 : 5.99;\nconst total = Math.round((subtotal + tax + shipping_cost) * 100) / 100;\n\nreturn {\n  json: {\n    ...order,\n    items_detailed: items,\n    subtotal: subtotal,\n    tax: tax,\n    shipping_cost: shipping_cost,\n    total: total,\n    processed_at: new Date().toISOString()\n  }\n};"
      },
      "id": "e7862cd8-cdf2-4ec4-8f85-59652d14509b",
      "name": "Calculate Totals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -96
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const order = $json;\nconst itemLines = order.items_detailed.map(item =>\n  `  ${item.quantity}x ${item.product} @ $${item.unit_price} = $${item.line_total}`\n).join('\\n');\n\nconst slip = `\n================================\nPACKING SLIP - ${order.order_id}\n================================\nCustomer: ${order.customer.name}\nEmail: ${order.customer.email}\nShipping: ${order.shipping}\n\nItems:\n${itemLines}\n\nSubtotal: $${order.subtotal}\nTax: $${order.tax}\nShipping: $${order.shipping_cost}\nTOTAL: $${order.total}\n================================\nProcessed: ${order.processed_at}\n`;\n\nreturn { json: { ...order, packing_slip: slip.trim() } };"
      },
