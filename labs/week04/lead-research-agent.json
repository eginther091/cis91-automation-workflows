    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\nconst report = `\n========================================\nLEAD RESEARCH REPORT\n========================================\nCompany: ${data.company_name}\nResearched: ${data.researched_at}\n\n--- Wikipedia Summary ---\n${data.wiki_summary}\nSource: ${data.wiki_url}\n\n--- Web Search ---\n${data.search_abstract}\nOfficial URL: ${data.official_url}\n========================================\n`;\n\nreturn { json: { ...data, formatted_report: report.trim() } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        -64
      ],
      "id": "e0566ef6-9b03-4d71-8358-2bd991898a18",
      "name": "Format Text Report"
    },
    {
      "parameters": {
        "jsCode": "return [\n  { json: { company_name: 'College of the Desert' } },\n  { json: { company_name: 'Google' } },\n  { json: { company_name: 'Tesla' } }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        -64
      ],
      "id": "ff0c08f6-ba0e-4142-9bc5-e0dbc4098185",
      "name": "Company List"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "reports",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1408,
        -64
      ],
      "id": "0de6e2bc-6075-4032-8235-1015617ed1e0",
      "name": "Aggregate"
    },
    {
      "parameters": {
        "jsCode": "const reports = $input.first().json.reports;\nconst summary = reports.map(r =>\n  `• ${r.company_name}: ${r.wiki_summary?.substring(0, 100)}...`\n).join('\\n');\n\nreturn [{\n  json: {\n    report_title: 'Lead Research Batch Report',\n    generated_at: new Date().toISOString(),\n    total_companies: reports.length,\n    summary: summary\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
