          "assignments": [
            {
              "id": "e6c66a7a-61ee-4ce4-8b5f-70756d5b6064",
              "name": "joke",
              "value": "={{ $json.joke }}",
              "type": "string"
            },
            {
              "id": "49c055ff-9ee6-4b58-99f5-5c5c21b30efc",
              "name": "joke_id",
              "value": "={{ $json.id}}",
              "type": "string"
            },
            {
              "id": "7b64cccc-f79c-4580-ae70-809d36abed35",
              "name": "fetched_at",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
