            },
            {
              "id": "68d5786f-d064-4db1-aa7b-afbaff9faaff",
              "name": "status",
              "value": "={{ $json.status === 200 ? 'Success' : 'Error' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
